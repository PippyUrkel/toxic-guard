# =========================================================================================
# ToxiGuard Discord Bot & NLP Engine Environment Configuration
# Course: Natural Language Processing (25PEC4CS1) - Fr. CRCE
# =========================================================================================

# Discord Bot Gateway Token (obtain from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Bot Command Prefix
DISCORD_BOT_PREFIX=!

# Moderation Sensitivity Thresholds (0.0 to 1.0)
# Content with any toxicity category >= TOXICITY_THRESHOLD is flagged & deleted
TOXICITY_THRESHOLD=0.50

# Automated Punishment Tiers
# Auto-Ban: Users posting content with toxicity >= AUTOBAN_THRESHOLD are automatically banned
AUTOBAN_THRESHOLD=0.85
AUTOBAN_ENABLED=true

# Auto-Timeout (Temporary Mute): Content between TIMEOUT_THRESHOLD and AUTOBAN_THRESHOLD
TIMEOUT_THRESHOLD=0.70
TIMEOUT_ENABLED=true
TIMEOUT_DURATION_MINUTES=15

# Message Management & Transparency
DELETE_FLAGGED_MESSAGES=true
SEND_PUBLIC_EXPLANATION=true
SEND_DM_ON_PUNISHMENT=true

# Audit Logging Channel ID (Optional: paste Discord Channel ID to route all mod logs there)
MOD_LOG_CHANNEL_ID=

# Flask NLP API Endpoint
NLP_API_URL=http://127.0.0.1:5000/predict
